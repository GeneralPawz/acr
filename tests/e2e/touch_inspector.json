{
  "name": "touch_inspector",
  "description": "The unit inspector in the touch skin (#499): a blank start on the inspector shows the nations as the drawer's nation list, the nation's units as icon cells and its controls (steppers for unit, clip, turn and enemy, the range switch, Neu aufstellen), the intents pick a unit, a nation and an enemy, and the ids of the unit list are hidden while the inspector is on.",
  "args": ["--ui", "touch"],
  "steps": [
    {"cmd": "start", "blank": {"inspector": true}},
    {"cmd": "wait", "ticks": 5},
    {"cmd": "view", "expect": [
      {"path": "view.editor.inspector", "eq": true},
      {"path": "view.editor.toggle.id", "eq": "editor/inspect"},
      {"path": "view.editor.entries.2.on", "eq": true},
      {"path": "view.editor.entries.2.id", "eq": "editor/inspect/nation/2"},
      {"path": "view.editor.groups.0.cells.0.id", "eq": "editor/inspect/pick/0"},
      {"path": "view.editor.groups.0.cells.0.on", "eq": true},
      {"path": "view.editor.controls.0.more", "eq": "editor/inspect/unit/+"},
      {"path": "view.editor.controls.1.more", "eq": "editor/inspect/clipstep/+"},
      {"path": "view.editor.controls.2.less", "eq": "editor/inspect/turn/-"}]},
    {"cmd": "state", "expect": {"path": "state.inspector.unit.type", "contains": "(EN)"}},
    {"cmd": "ui_send", "msg": {"t": "intent", "seq": 10, "id": "editor/inspect/pick/5", "action": {"t": "click", "button": "left"}}},
    {"cmd": "wait", "ticks": 2},
    {"cmd": "state", "expect": {"path": "state.inspector.unit.type", "eq": "EngM18(EN)"}},
    {"cmd": "view", "expect": {"path": "view.editor.groups.0.cells.5.on", "eq": true}},
    {"cmd": "ui_send", "msg": {"t": "intent", "seq": 11, "id": "editor/inspect/turn/+", "action": {"t": "click", "button": "left"}}},
    {"cmd": "ui_send", "msg": {"t": "intent", "seq": 12, "id": "editor/inspect/pick/99", "action": {"t": "click", "button": "left"}}, "expect": {"ok": false}},
    {"cmd": "ui_send", "msg": {"t": "intent", "seq": 1, "id": "editor/inspect/nation/3", "action": {"t": "click", "button": "left"}}},
    {"cmd": "wait", "ticks": 2},
    {"cmd": "state", "expect": {"path": "state.inspector.unit.type", "contains": "(FR)"}},
    {"cmd": "ui_send", "msg": {"t": "intent", "seq": 2, "id": "editor/inspect/enemy/+", "action": {"t": "click", "button": "left"}}},
    {"cmd": "wait", "ticks": 2},
    {"cmd": "state", "expect": {"path": "state.inspector.enemy.type", "eq": "EngM18(EN)"}},
    {"cmd": "ui_send", "msg": {"t": "intent", "seq": 3, "id": "editor/inspect/range", "action": {"t": "click", "button": "left"}}},
    {"cmd": "ui_send", "msg": {"t": "intent", "seq": 4, "id": "editor/nation/3", "action": {"t": "click", "button": "left"}}, "expect": {"ok": false}, "note": "the unit list is hidden"},
    {"cmd": "ui_send", "msg": {"t": "intent", "seq": 5, "id": "editor/inspect/clip/0", "action": {"t": "click", "button": "left"}}, "expect": {"ok": false}, "note": "no model drawn without a GPU: no clip list"},
    {"cmd": "ui_send", "msg": {"t": "intent", "seq": 6, "id": "editor/inspect", "action": {"t": "click", "button": "left"}}},
    {"cmd": "view", "expect": {"path": "view.editor.toggle.id", "eq": "editor/battle"}}
  ]
}
