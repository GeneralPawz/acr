{
  "name": "touch_build",
  "description": "Touch mode (#439): after picking the Fort with a finger its outline appears in the middle of the window; a tap moves it, a drag slides it (nothing is placed, not even by a slow second tap), a double tap places it, a long press cancels, and Escape cancels",
  "steps": [
    {"cmd": "start", "random": {"nation": 1, "seed": 5}},
    {"cmd": "wait", "ticks": 200},
    {"cmd": "state", "capture": {"wood": "state.resources.wood"}},
    {"cmd": "drag", "around": {"owner": 0, "type": "Kri"}},
    {"cmd": "touch", "phase": "start", "id": 1, "label": "Fort", "t": 0},
    {"cmd": "touch", "phase": "end", "id": 1, "label": "Fort", "t": 60},
    {"cmd": "ui", "expect": [{"path": "ui.cursor.mode", "contains": "placing"}, {"path": "ui.cursor.outline", "exists": true}]},
    {"cmd": "touch", "phase": "start", "id": 1, "pos": [500, 300], "t": 1000},
    {"cmd": "touch", "phase": "end", "id": 1, "pos": [500, 300], "t": 1050},
    {"cmd": "ui", "expect": [{"path": "ui.cursor.outline.0", "eq": 500}, {"path": "ui.cursor.outline.1", "eq": 300}]},
    {"cmd": "touch", "phase": "start", "id": 1, "pos": [520, 320], "t": 2000},
    {"cmd": "touch", "phase": "move", "id": 1, "pos": [620, 370], "t": 2050},
    {"cmd": "touch", "phase": "move", "id": 1, "pos": [720, 420], "t": 2100},
    {"cmd": "touch", "phase": "end", "id": 1, "pos": [720, 420], "t": 2150},
    {"cmd": "ui", "expect": [{"path": "ui.cursor.outline.0", "eq": 700}, {"path": "ui.cursor.outline.1", "eq": 400}], "note": "a drag moves the outline by as much as the finger, grabbed anywhere"},
    {"cmd": "touch", "phase": "start", "id": 1, "pos": [700, 400], "t": 2300},
    {"cmd": "touch", "phase": "end", "id": 1, "pos": [700, 400], "t": 2350},
    {"cmd": "wait", "ticks": 1},
    {"cmd": "state", "expect": {"path": "state.counts.0.sites", "len_eq": 0}, "note": "a tap right after a drag is no double tap"},
    {"cmd": "touch", "phase": "start", "id": 1, "pos": [500, 300], "t": 4000},
    {"cmd": "touch", "phase": "end", "id": 1, "pos": [500, 300], "t": 4050},
    {"cmd": "touch", "phase": "start", "id": 1, "pos": [500, 300], "t": 6000},
    {"cmd": "touch", "phase": "tick", "t": 6600},
    {"cmd": "touch", "phase": "end", "id": 1, "pos": [500, 300], "t": 6650},
    {"cmd": "ui", "expect": {"path": "ui.cursor.mode", "eq": "normal"}, "note": "a long press cancels"},
    {"cmd": "touch", "phase": "start", "id": 1, "label": "Fort", "t": 8000},
    {"cmd": "touch", "phase": "end", "id": 1, "label": "Fort", "t": 8050},
    {"cmd": "ui", "expect": {"path": "ui.cursor.mode", "contains": "placing"}},
    {"cmd": "key", "key": "Escape"},
    {"cmd": "ui", "expect": {"path": "ui.cursor.mode", "eq": "normal"}},
    {"cmd": "touch", "phase": "start", "id": 1, "label": "Fort", "t": 10050},
    {"cmd": "touch", "phase": "end", "id": 1, "label": "Fort", "t": 10100},
    {"cmd": "ui", "expect": {"path": "ui.cursor.mode", "contains": "placing"}},
    {"cmd": "touch", "phase": "start", "id": 1, "near": {"owner": 0, "type": "Kri"}, "offset": [0, 700], "t": 12100},
    {"cmd": "touch", "phase": "end", "id": 1, "near": {"owner": 0, "type": "Kri"}, "offset": [0, 700], "t": 12150},
    {"cmd": "touch", "phase": "start", "id": 1, "near": {"owner": 0, "type": "Kri"}, "offset": [0, 700], "t": 12800},
    {"cmd": "touch", "phase": "end", "id": 1, "near": {"owner": 0, "type": "Kri"}, "offset": [0, 700], "t": 12850},
    {"cmd": "wait", "ticks": 1},
    {"cmd": "state", "expect": {"path": "state.counts.0.sites", "len_eq": 0}, "note": "single taps and a slow second tap never place"},
    {"cmd": "touch", "phase": "start", "id": 1, "near": {"owner": 0, "type": "Kri"}, "offset": [0, 700], "t": 13000},
    {"cmd": "touch", "phase": "end", "id": 1, "near": {"owner": 0, "type": "Kri"}, "offset": [0, 700], "t": 13050},
    {"cmd": "wait", "ticks": 1},
    {"cmd": "state", "expect": [{"path": "state.counts.0.sites", "len_eq": 1}, {"path": "state.resources.wood", "lt": "${wood}"}]},
    {"cmd": "ui", "expect": {"path": "ui.cursor.mode", "eq": "normal"}}
  ]
}
