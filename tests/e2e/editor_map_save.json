{
  "name": "editor_map_save",
  "description": "A saved editor map keeps what was painted and put on it (#430, #406): a hill, a pool of water with a ship on it, Erde, a tree, a finished town hall and a formation at a training level. Saved and loaded again, the ground, the objects and the units return.",
  "touch": false,
  "steps": [
    {"cmd": "start", "blank": {"editor": true}},
    {"cmd": "wait", "ticks": 5},
    {"cmd": "click", "label": "Nation", "exact": true},
    {"cmd": "click", "label": "Nation Gelaende", "exact": true},
    {"cmd": "click", "label": "Anheben", "exact": true},
    {"cmd": "click", "world": [8000, 6500]},
    {"cmd": "click", "label": "Wasser", "exact": true},
    {"cmd": "click", "world": [9000, 7700]},
    {"cmd": "click", "label": "Erde", "exact": true},
    {"cmd": "click", "world": [6000, 7000]},
    {"cmd": "click", "label": "Nation", "exact": true},
    {"cmd": "click", "label": "Nation Natur", "exact": true},
    {"cmd": "click", "label": "[AG 0]", "note": "the first tree"},
    {"cmd": "click", "world": [7000, 7300]},
    {"cmd": "click", "label": "Nation", "exact": true},
    {"cmd": "click", "label": "Nation England", "exact": true},
    {"cmd": "click", "label": "Seite runter", "exact": true, "note": "scroll to the ships"},
    {"cmd": "click", "label": "Anzahl -", "exact": true, "note": "36 -> 15"},
    {"cmd": "click", "label": "Anzahl -", "exact": true, "note": "10"},
    {"cmd": "click", "label": "Anzahl -", "exact": true, "note": "5"},
    {"cmd": "click", "label": "Anzahl -", "exact": true, "note": "1"},
    {"cmd": "click", "label": "(ShpFregat(EN))", "note": "the frigate icon"},
    {"cmd": "click", "world": [9000, 7700], "note": "on the painted water"},
    {"cmd": "wheel", "lines": -6, "note": "scroll to the buildings"},
    {"cmd": "click", "label": "(EngCen(EN))", "note": "the town hall icon"},
    {"cmd": "click", "world": [6500, 7800]},
    {"cmd": "click", "label": "Nation", "exact": true},
    {"cmd": "click", "label": "Nation Frankreich", "exact": true},
    {"cmd": "click", "label": "Anzahl +", "exact": true, "note": "1 -> 5"},
    {"cmd": "click", "label": "Anzahl +", "exact": true, "note": "10"},
    {"cmd": "click", "label": "Anzahl +", "exact": true, "note": "15"},
    {"cmd": "rclick", "label": "(FrnM18(FR))", "note": "opens the level drop-down"},
    {"cmd": "click", "label": "Ausbau Spezialmusketen kaufen"},
    {"cmd": "click", "label": "Formation +", "exact": true, "note": "the first formation"},
    {"cmd": "click", "world": [7000, 8300]},
    {"cmd": "wait", "ticks": 30},
    {"cmd": "state", "expect": [
      {"path": "state.map_objects.trees", "eq": 1},
      {"path": "state.counts.0.buildings.EngCen(EN)", "eq": 1},
      {"path": "state.counts.0.units.ShpFregat(EN)", "eq": 1},
      {"path": "state.counts.0.units.FrnM18(FR)", "ge": 15}],
      "capture": {"french": "state.counts.0.units.FrnM18(FR)"}},
    {"cmd": "state", "units": true, "detail": true, "owner": 0, "type": "FrnM18(FR)", "expect": {"path": "state.units.0.adv.pause.1", "eq": 159}},
    {"cmd": "save", "name": "e2e_map_save"},
    {"cmd": "wait", "ticks": 20},
    {"cmd": "load", "name": "e2e_map_save"},
    {"cmd": "wait", "until": {"in_game": true}, "timeout": 20000},
    {"cmd": "state", "expect": [
      {"path": "state.map_objects.trees", "eq": 1},
      {"path": "state.counts.0.buildings.EngCen(EN)", "eq": 1},
      {"path": "state.counts.0.units.ShpFregat(EN)", "eq": 1},
      {"path": "state.counts.0.units.FrnM18(FR)", "eq": "${french}"}]},
    {"cmd": "state", "units": true, "detail": true, "owner": 0, "type": "FrnM18(FR)", "expect": {"path": "state.units.0.adv.pause.1", "eq": 159}},
    {"cmd": "ground", "world": [8000, 6500], "expect": {"path": "ground.height", "gt": 0}},
    {"cmd": "ground", "world": [9000, 7700], "expect": [
      {"path": "ground.depth", "gt": 130},
      {"path": "ground.land_locked", "eq": true},
      {"path": "ground.water_locked", "eq": false}]},
    {"cmd": "ground", "world": [6000, 7000], "expect": {"path": "ground.tile", "eq": 71}}
  ]
}
