{
  "name": "market_trade",
  "description": "A Sioux random map built up to the Handelsposten (Reiterstall, Wohnzelt, Lagerhaus): selecting it shows the market in the command grid, and selling wood for gold pays at the market's rate (ECO::PerformOperation 0x4a9d80) (#356)",
  "step_timeout_s": 180,
  "steps": [
    {"cmd": "start", "random": {"nation": 11, "seed": 5, "resources": 2}},
    {"cmd": "wait", "ticks": 100},
    {"cmd": "drag", "around": {"owner": 0, "type": "SiuKri"}},
    {"cmd": "click", "label": "Reiterstall"},
    {"cmd": "click", "near": {"owner": 0, "type": "SiuKri"}, "offset": [0, 700]},
    {"cmd": "wait", "until": {"units": {"owner": 0, "type": "SiuKre", "finished": true}}, "timeout": 3000},
    {"cmd": "drag", "around": {"owner": 0, "type": "SiuKri"}},
    {"cmd": "click", "label": "Wohnzelt I"},
    {"cmd": "click", "near": {"owner": 0, "type": "SiuKri"}, "offset": [-700, 700]},
    {"cmd": "wait", "until": {"units": {"owner": 0, "type": "SiuDo1", "finished": true}}, "timeout": 3000},
    {"cmd": "drag", "around": {"owner": 0, "type": "SiuKri"}},
    {"cmd": "click", "label": "Lagerhaus"},
    {"cmd": "click", "near": {"owner": 0, "type": "SiuKri"}, "offset": [700, 700]},
    {"cmd": "wait", "until": {"units": {"owner": 0, "type": "IroSkl", "finished": true}}, "timeout": 3000},
    {"cmd": "drag", "around": {"owner": 0, "type": "SiuKri"}},
    {"cmd": "click", "label": "Handelsposten"},
    {"cmd": "click", "near": {"owner": 0, "type": "SiuKri"}, "offset": [1400, 0]},
    {"cmd": "wait", "until": {"units": {"owner": 0, "type": "SiuPst", "finished": true}}, "timeout": 3000},
    {"cmd": "click", "unit": {"owner": 0, "type": "SiuPst"}},
    {"cmd": "ui", "expect": {"path": "ui.widgets", "len_ge": 20}},
    {"cmd": "state", "capture": {"wood": "state.resources.wood", "gold": "state.resources.gold"}},
    {"cmd": "click", "id": "hud/12", "note": "sell wood"},
    {"cmd": "click", "id": "hud/32", "note": "buy gold"},
    {"cmd": "click", "id": "hud/6", "note": "+1000"},
    {"cmd": "click", "id": "hud/4", "note": "r_Buy"},
    {"cmd": "wait", "ticks": 3},
    {"cmd": "state", "expect": [{"path": "state.resources.wood", "lt": "${wood}"}, {"path": "state.resources.gold", "gt": "${gold}"}]}
  ]
}
