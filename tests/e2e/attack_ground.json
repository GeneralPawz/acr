{
  "name": "attack_ground",
  "description": "On a random map (no mission script) build up to the Festung, research its stables and artillery depot, train a cannon from peasants (it drives out of the Festung), then order it through the HUD's 'Boden angreifen' icon to bombard a point on the ground: it fires and pays iron and coal (#191). The Festung, idle again, shoots the neutral Delaware barracks next to the base: the cannon ball sets it burning, it collapses and disappears (DESTRUCT, #184)",
  "step_timeout_s": 180,
  "steps": [
    {"cmd": "start", "random": {"nation": 1, "seed": 5, "resources": 2}},
    {"cmd": "wait", "ticks": 200},
    {"cmd": "drag", "around": {"owner": 0, "type": "Kri"}},
    {"cmd": "click", "label": "Fort"},
    {"cmd": "click", "near": {"owner": 0, "type": "Kri"}, "offset": [-1350, 600]},
    {"cmd": "wait", "until": {"units": {"owner": 0, "type": "EngKre", "finished": true}}, "timeout": 20000},
    {"cmd": "drag", "around": {"owner": 0, "type": "Kri"}},
    {"cmd": "click", "label": "Wohnhaus"},
    {"cmd": "click", "near": {"owner": 0, "type": "Kri"}, "offset": [-900, 600]},
    {"cmd": "wait", "until": {"units": {"owner": 0, "type": "SpnDo1", "finished": true}}, "timeout": 20000},
    {"cmd": "drag", "around": {"owner": 0, "type": "Kri"}},
    {"cmd": "click", "label": "Mühle"},
    {"cmd": "click", "near": {"owner": 0, "type": "Kri"}, "offset": [-450, 600]},
    {"cmd": "wait", "until": {"units": {"owner": 0, "type": "SpnMel", "finished": true}}, "timeout": 20000},
    {"cmd": "drag", "around": {"owner": 0, "type": "Kri"}},
    {"cmd": "click", "label": "Lagerhaus"},
    {"cmd": "click", "near": {"owner": 0, "type": "Kri"}, "offset": [0, 600]},
    {"cmd": "wait", "until": {"units": {"owner": 0, "type": "SpnSkl", "finished": true}}, "timeout": 20000},
    {"cmd": "drag", "around": {"owner": 0, "type": "Kri"}},
    {"cmd": "click", "label": "Schmiede"},
    {"cmd": "click", "near": {"owner": 0, "type": "Kri"}, "offset": [450, 600]},
    {"cmd": "wait", "until": {"units": {"owner": 0, "type": "SpnKuz", "finished": true}}, "timeout": 20000},
    {"cmd": "drag", "around": {"owner": 0, "type": "Kri"}},
    {"cmd": "click", "label": "Festung"},
    {"cmd": "click", "near": {"owner": 0, "type": "Kri"}, "offset": [1500, -1200]},
    {"cmd": "wait", "until": {"units": {"owner": 0, "type": "SpnKre", "finished": true}}, "timeout": 30000},
    {"cmd": "click", "unit": {"owner": 0, "type": "SpnKre"}, "expect": {"path": "target.type", "contains": "SpnKre"}},
    {"cmd": "click", "label": "Untermenü"},
    {"cmd": "click", "label": "Reiterstall bauen"},
    {"cmd": "wait", "until": {"label": "Artilleriedepot bauen"}, "timeout": 3000},
    {"cmd": "click", "label": "Artilleriedepot bauen"},
    {"cmd": "wait", "until": {"label": "Kanone - "}, "timeout": 3000},
    {"cmd": "click", "label": "Kanone - ", "expect": {"path": "target.kind", "eq": "icon"}},
    {"cmd": "drag", "around": {"owner": 0, "type": "Kri", "max": 5}},
    {"cmd": "rclick", "unit": {"owner": 0, "type": "SpnKre"}, "note": "peasants walk in and are trained"},
    {"cmd": "wait", "until": {"units": {"owner": 0, "type": "ArtPus", "min": 1}}, "timeout": 3000},
    {"cmd": "wait", "ticks": 900, "note": "the cannon drives out of the Festung (in unlimited motion it takes no orders)"},
    {"cmd": "click", "unit": {"owner": 0, "type": "ArtPus"}, "expect": {"path": "target.type", "contains": "ArtPus"}},
    {"cmd": "state", "capture": {"iron": "state.resources.iron", "coal": "state.resources.coal"},
     "expect": [{"path": "state.selection", "len_eq": 1}, {"path": "state.selection.0.type", "contains": "ArtPus"}]},
    {"cmd": "click", "label": "Boden angreifen", "expect": {"path": "target.kind", "eq": "icon"}},
    {"cmd": "ui", "expect": {"path": "ui.cursor.mode", "eq": "attack_ground"}},
    {"cmd": "click", "pos": [700, 500], "note": "the next map click is the point, south-east of the centred cannon"},
    {"cmd": "ui", "expect": {"path": "ui.cursor.mode", "eq": "normal"}},
    {"cmd": "wait", "ticks": 400},
    {"cmd": "state", "expect": [
      {"path": "state.resources.iron", "lt": "${iron}"},
      {"path": "state.resources.coal", "lt": "${coal}"}
    ], "note": "every shot pays iron and coal"},
    {"cmd": "wait", "ticks": 600},
    {"cmd": "state", "expect": [
      {"path": "state.counts.7.buildings.DelKaz(DE)", "eq": 1},
      {"path": "state.counts.7.burning.DelKaz(DE)", "exists": false}
    ], "note": "the idle Festung's cannon balls set the neutral barracks next to the base burning; it burnt down and is gone (when depends on the random draws)"}
  ]
}
