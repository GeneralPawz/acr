{
  "name": "editor_save_load",
  "description": "A saved editor game keeps what the editor did (#427): the editor window itself, Fuesiliere at an upgrade level (player 1), a finished town hall, an army preset (player 2), Kampf AN. Saved and loaded again, the counts, the upgrade and the window return.",
  "touch": false,
  "steps": [
    {"cmd": "start", "blank": {"editor": true}},
    {"cmd": "wait", "ticks": 5},
    {"cmd": "click", "label": "Nation", "exact": true},
    {"cmd": "click", "label": "Nation Frankreich", "exact": true},
    {"cmd": "click", "label": "Anzahl -", "exact": true, "note": "36 -> 15"},
    {"cmd": "click", "label": "Anzahl -", "exact": true, "note": "10"},
    {"cmd": "click", "label": "Anzahl -", "exact": true, "note": "5"},
    {"cmd": "rclick", "label": "(FrnM18(FR))", "note": "opens the level drop-down"},
    {"cmd": "click", "label": "Ausbau Spezialmusketen kaufen"},
    {"cmd": "click", "pos": [700, 500]},
    {"cmd": "click", "label": "Kampf", "exact": true, "note": "AN"},
    {"cmd": "click", "label": "Nation", "exact": true},
    {"cmd": "click", "label": "Nation England", "exact": true},
    {"cmd": "wheel", "lines": -6, "note": "scroll to the buildings"},
    {"cmd": "click", "label": "(EngCen(EN))", "note": "the town hall icon"},
    {"cmd": "click", "pos": [600, 700]},
    {"cmd": "rclick", "pos": [700, 300], "note": "stops placing"},
    {"cmd": "click", "label": "Spieler 2", "exact": true},
    {"cmd": "rclick", "label": "Nation", "exact": true},
    {"cmd": "click", "label": "Armee 17. Jahrhundert", "exact": true},
    {"cmd": "click", "label": "Armee Klein", "exact": true},
    {"cmd": "click", "pos": [400, 400], "note": "places the army"},
    {"cmd": "wait", "ticks": 30},
    {"cmd": "state", "expect": [
      {"path": "state.counts.0.units.FrnM18(FR)", "ge": 1},
      {"path": "state.counts.0.buildings.EngCen(EN)", "eq": 1},
      {"path": "state.counts.1.units.EngMus(EN)", "ge": 60}]},
    {"cmd": "state", "units": true, "detail": true, "owner": 0, "expect": {"path": "state.units.0.adv.pause.1", "eq": 159}},
    {"cmd": "state", "capture": {"french": "state.counts.0.units.FrnM18(FR)", "muskets": "state.counts.1.units.EngMus(EN)"}},
    {"cmd": "save", "name": "e2e_editor"},
    {"cmd": "wait", "ticks": 20},
    {"cmd": "load", "name": "e2e_editor"},
    {"cmd": "wait", "until": {"in_game": true}, "timeout": 20000},
    {"cmd": "state", "expect": [
      {"path": "state.counts.0.units.FrnM18(FR)", "eq": "${french}"},
      {"path": "state.counts.0.buildings.EngCen(EN)", "eq": 1},
      {"path": "state.counts.1.units.EngMus(EN)", "eq": "${muskets}"}]},
    {"cmd": "state", "units": true, "detail": true, "owner": 0, "expect": {"path": "state.units.0.adv.pause.1", "eq": 159}},
    {"cmd": "click", "label": "Armee Klein", "exact": true, "expect": {"ok": false}, "note": "the army menu is closed"},
    {"cmd": "click", "label": "Kampf", "exact": true, "note": "the editor window is back"}
  ]
}
