<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView spike (docs/webui.md): its own package, so it never touches the game's app or data. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.generalpawz.acr.webviewspike"
    android:versionCode="1"
    android:versionName="0.1">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />
    <application
        android:label="ACR WebView spike"
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="webview_spike_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
